{
  "mcpServers": {
    "outside-in-tdd": {
      "command": "/path/to/your/.local/bin/outside-in-tdd-mcp",
      "args": [],
      "env": {
        "TDD_PROJECT_ROOT": "/path/to/your-project",
        "TDD_CONFIG_PATH": "/path/to/your-project/.tdd-config.json",
        "PATH": "/path/to/your-project/.venv/bin:/usr/bin:/bin"
      }
    }
  }
}
