{
  "mcpServers": {
    "project-mcp": {
      "command": "/usr/local/bin/mcpctl",
      "args": ["run", "project-mcp"]
    },
    "outside-in-tdd": {
      "command": "uv",
      "args": ["run", "--quiet", "outside-in-tdd-mcp"],
      "env": {
        "TDD_ADAPTER_TIMEOUT_S": "120"
      }
    }
  }
}
